# Copy to .env and fill in the values you need. All keys are optional —
# each script only requires the keys for the services it calls.

# ── Model evaluation (scripts/test_LLM.py, scripts/eval.py) ──────────────────
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Azure OpenAI (alternative to OPENAI_API_KEY; also used by
# scripts/validate_questions/)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VER=

# Web-search condition (scripts/web_search.py)
YOU_API_KEY=

# ── Scrapers (scripts/scrape/) ───────────────────────────────────────────────
# Springer Nature Meta API key — free at https://dev.springernature.com/
SPRINGER_API_KEY=
